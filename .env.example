# Copy to .env and adjust. Unset DATABASE_URL (or omit it) to have `npm run dev` start its own
# embedded PostgreSQL instead — see README.md.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/archboard
JWT_SECRET=change-me-in-production
APP_TIMEZONE=Asia/Ho_Chi_Minh
UPLOAD_DIR=./uploads
BACKEND_URL=http://localhost:4000
PORT=4000
NODE_ENV=development

# docker-compose.yml only (production Postgres password):
POSTGRES_PASSWORD=archboard
